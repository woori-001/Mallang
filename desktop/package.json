{
  "name": "mallang-memo",
  "version": "3.1.2",
  "description": "투명하고 말랑한 데스크톱 메모 앱",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/build-fonts.js",
    "icon": "python3 scripts/make-icon.py",
    "dist": "npm run fonts && electron-builder --win nsis --x64 --publish never",
    "web": "node scripts/copy-web.js",
    "release": "npm run fonts && electron-builder --win nsis --x64 --publish always"
  },
  "keywords": [],
  "author": "말랑메모",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/dongle": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/gamja-flower": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/hi-melody": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/nanum-gothic": "^5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/poor-story": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/single-day": "^5.3.1",
    "@fontsource/sunflower": "^5.3.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "productName": "말랑메모",
  "build": {
    "appId": "com.mallang.memo",
    "productName": "말랑메모",
    "copyright": "말랑메모",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/{darwin*,freebsd*,linux*,openbsd*,musl*,win32_ia32,win32_arm64}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "MallangMemo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "말랑메모",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "woori-001",
        "repo": "Mallang",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woori-001/Mallang.git"
  }
}
