<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱 안에서 새 버전 받아 설치 (설치 확인은 사용자가 직접 누름) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 갤럭시(휴대폰) 캘린더 일정을 말랑메모로 가져오기 (읽기만, 사용자가 버튼을 눌렀을 때만) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <application
        android:label="말랑메모"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PreviewActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver android:name=".InstallResult" android:exported="false" />
        <receiver android:name=".CalendarWidget" android:exported="true" android:label="말랑 달력">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/calendar_widget" />
        </receiver>
    </application>
</manifest>
